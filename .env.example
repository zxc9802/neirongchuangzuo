# Server-side only. Copy to .env.local and supply your OpenLux key.
AUTH_MODE=standalone
OPENLUX_API_KEY=
OPENLUX_CHAT_MODEL=gpt-6-luna
OPENLUX_IMAGE_MODEL=gpt-image-2.5-sunburst-c
# Global attempted-call limits; reset at midnight in Asia/Shanghai. 0 disables.
AI_IMAGE_DAILY_LIMIT=20
AI_CHAT_DAILY_LIMIT=100
AI_REQUESTS_PER_MINUTE=10

# Restaurant workflow: production defaults to AUTH_DATABASE_URL.
# Keep connection strings and COS keys out of Git.
RESTAURANT_DATABASE_URL=
# Successful packages per account/day. Analysis and failures do not charge this quota.
RESTAURANT_PACKAGE_DAILY_LIMIT=20
# Durable local state for generic AI and restaurant model-call controls.
WORKSPACE_DATA_DIR=.data
# Zeabur: mount /app/.data AND /app/services/digital-human/.runtime.
# Only a bare-metal operator with durable directories should set this bypass to 1.
PERSISTENT_STORAGE_CONFIRMED=0
# Optional private restaurant media storage; configure all four or leave all empty.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# AI remix: server-side folder embeddings, reranking and narration.
# Docker supplies Python; local development uses an absolute virtualenv Python path.
MIX_PYTHON_BIN=
RERANK_API_KEY=
# Optional provider endpoint overrides (never supplied by users).
EMBEDDING_URL=
LLM_URL=
RERANK_URL=
# Synthesized narration uses IndexTTS. Original audio mode does not require TTS.
INDEXTTS_302_API_KEY=
INDEXTTS_BASE_URL=https://api.302.ai
# Optional default voice; unnecessary when the user selects an uploaded voice.
INDEXTTS_SPEAKER_AUDIO_URL=
INDEXTTS_EMOTION_AUDIO_URL=
INDEXTTS_EMOTION_AUDIO_PATH=
INDEXTTS_DOWNLOAD_HOSTS=302.ai

# Private remix voice/music library. Independent from restaurant/digital-human COS.
# Configure all four; never expose these credentials in the browser.
MIX_AUDIO_COS_SECRET_ID=
MIX_AUDIO_COS_SECRET_KEY=
MIX_AUDIO_COS_BUCKET=hjyp-1410143389
MIX_AUDIO_COS_REGION=ap-singapore

# AI video: Seedance 2.0 person replacement. Server-side only.
VIDEO_API_BASE_URL=http://14.103.147.238:19220
VIDEO_PROJECT_CODE=
VIDEO_ACCESS_KEY=
VIDEO_SECRET_KEY=
# Defaults to the workspace AUTH_PUBLIC_URL in production. Must be this service's HTTPS origin.
VIDEO_PUBLIC_BASE_URL=
# Material credentials default to their VIDEO_* counterparts.
MATERIAL_API_BASE_URL=
MATERIAL_PROJECT_CODE=
MATERIAL_ACCESS_KEY=
MATERIAL_SECRET_KEY=
# Random persistent secret (at least 32 bytes recommended) for expiring source URLs.
TEMP_ASSET_SIGNING_SECRET=

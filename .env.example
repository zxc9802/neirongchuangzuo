# Server-side only. Copy to .env.local and supply your OpenLux key.
AUTH_MODE=standalone
OPENLUX_API_KEY=
OPENLUX_CHAT_MODEL=gpt-6-luna
OPENLUX_IMAGE_TEXT_MODEL=claude-opus-5-5
OPENLUX_IMAGE_MODEL=gpt-image-2.5-sunburst-c
CREDITS_BILLING_MODE=api_cost
OPENLUX_IMAGE_BILLING_GROUP=Gpt-Image-3
OPENLUX_IMAGE_TEXT_BILLING_GROUP=AWS-Bedrock-2
OPENLUX_CHAT_BILLING_GROUP=Codex-Gpt-3
# Image fallback after the initial primary call and three retries.
FAL_IMAGE_KEY=
FAL_IMAGE_MODEL=openai/gpt-image-2.5/sunburst/edit
# Image daily calls are unlimited by default; set an integer to cap them. 0 disables.
AI_IMAGE_DAILY_LIMIT=unlimited
AI_CHAT_DAILY_LIMIT=100
AI_DAILY_EXEMPT_ACCOUNTS=zxc9911
AI_REQUESTS_PER_MINUTE=10

# Restaurant workflow: production defaults to AUTH_DATABASE_URL.
# Keep connection strings and COS keys out of Git.
RESTAURANT_DATABASE_URL=
# Successful packages per account/day. Analysis and failures do not charge this quota.
RESTAURANT_PACKAGE_DAILY_LIMIT=20
# Durable local state for generic AI and restaurant model-call controls.
WORKSPACE_DATA_DIR=.data
# Zeabur: mount /app/.data AND /app/services/digital-human/.runtime.
# Only a bare-metal operator with durable directories should set this bypass to 1.
PERSISTENT_STORAGE_CONFIRMED=0
# Optional private restaurant media storage; configure all four or leave all empty.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Restaurant promotional cutouts. Docker supplies both Python and the subject model.
# Local Python needs numpy, onnxruntime, Pillow and opencv-python-headless; run node scripts/setup-restaurant-model.mjs.
RESTAURANT_PYTHON_BIN=
RESTAURANT_SUBJECT_MODEL_PATH=

# AI remix: server-side folder embeddings, reranking and narration.
# Docker supplies Python; local development uses an absolute virtualenv Python path.
MIX_PYTHON_BIN=
RERANK_API_KEY=
# Optional provider endpoint overrides (never supplied by users).
EMBEDDING_URL=
LLM_URL=
RERANK_URL=
# New remix narration uses fal IndexTTS2 with a reference voice.
# Server only. Original audio needs no TTS key.
MIX_FAL_KEY=
# Digital-human narration uses fal IndexTTS2, with FAL_KEY / FAL_API_KEY / VIDEO_FAL_KEY in that order.
# Legacy remix checkpoints and motion transcription still use the following 302 settings.
INDEXTTS_302_API_KEY=
INDEXTTS_BASE_URL=https://api.302.ai
# Default reference for fal and legacy IndexTTS; optional when uploading a voice.
INDEXTTS_SPEAKER_AUDIO_URL=
INDEXTTS_EMOTION_AUDIO_URL=
INDEXTTS_EMOTION_AUDIO_PATH=
INDEXTTS_DOWNLOAD_HOSTS=302.ai

# 数字人口播的豆包声音复刻 2.0 兜底；未映射的音色不会被替换。
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE_MAP={"voice_id":"S_your_speaker_id"}

# Private remix voice/music library. Independent from restaurant/digital-human COS.
# Configure all four; never expose these credentials in the browser.
MIX_AUDIO_COS_SECRET_ID=
MIX_AUDIO_COS_SECRET_KEY=
MIX_AUDIO_COS_BUCKET=hjyp-1410143389
MIX_AUDIO_COS_REGION=ap-singapore

# Private AI remix video materials; independent from audio and digital-human buckets.
# Use compute in the same cloud/region and persist WORKSPACE_DATA_DIR for SQLite/FAISS.
MIX_MATERIAL_COS_SECRET_ID=
MIX_MATERIAL_COS_SECRET_KEY=
MIX_MATERIAL_COS_BUCKET=hunjianx-1410143389
MIX_MATERIAL_COS_REGION=ap-singapore

# AI video: Seedance 2.0 person replacement. Server-side only.
VIDEO_API_BASE_URL=http://14.103.147.238:19220
VIDEO_PROJECT_CODE=
VIDEO_ACCESS_KEY=
VIDEO_SECRET_KEY=
# Wan 3.0 standard, Beijing official DashScope API. Server only; separate from fal voice conversion.
# Requires CREDITS_BILLING_MODE=api_cost when workspace credits are enabled.
DASHSCOPE_API_KEY=
# Person-replica Chatterbox voice conversion, transcription, media storage and legacy fal tasks (server only).
# PixVerse requires CREDITS_BILLING_MODE=api_cost when workspace credits are enabled.
# Uses FAL_KEY or FAL_API_KEY first, otherwise VIDEO_FAL_KEY. New narration does not use INDEXTTS_BASE_URL.
VIDEO_FAL_KEY=
# Official HeyGen Precision, used only when English/Malay differs from the detected source language.
VIDEO_HEYGEN_API_KEY=
# Defaults to the workspace AUTH_PUBLIC_URL in production. Must be this service's HTTPS origin.
VIDEO_PUBLIC_BASE_URL=
VIDEO_GENERATION_CNY_PER_SECOND=1
VIDEO_DIRECTOR_MAX_OUTPUT_TOKENS=16384
VIDEO_CREATOR_VIDEO_API_BASE_URL=
VIDEO_CREATOR_VIDEO_PROJECT_CODE=
VIDEO_CREATOR_VIDEO_ACCESS_KEY=
VIDEO_CREATOR_VIDEO_SECRET_KEY=
VIDEO_CREATOR_MATERIAL_API_BASE_URL=
VIDEO_CREATOR_MATERIAL_PROJECT_CODE=
VIDEO_CREATOR_MATERIAL_ACCESS_KEY=
VIDEO_CREATOR_MATERIAL_SECRET_KEY=
VIDEO_CREATOR_PUBLIC_BASE_URL=
VIDEO_CREATOR_SIGNING_SECRET=
# Optional temporary CDN hosting, needed when testing from localhost without a public HTTPS origin.
VIDEO_CREATOR_STORAGE_KEY=
# Set all three together only when Seedance 2.5 uses a separate upstream project.
VIDEO_CREATOR_SEEDANCE_25_PROJECT_CODE=
VIDEO_CREATOR_SEEDANCE_25_ACCESS_KEY=
VIDEO_CREATOR_SEEDANCE_25_SECRET_KEY=
# Material credentials default to their VIDEO_* counterparts.
MATERIAL_API_BASE_URL=
MATERIAL_PROJECT_CODE=
MATERIAL_ACCESS_KEY=
MATERIAL_SECRET_KEY=
# Random persistent secret (at least 32 bytes recommended) for expiring source URLs.
TEMP_ASSET_SIGNING_SECRET=
# Replica speech-to-text uses fal Scribe V2 and the same FAL_KEY / FAL_API_KEY / VIDEO_FAL_KEY.
# No separate transcription key or base URL is required.
# Docker defaults to MIX_PYTHON_BIN; local environments need numpy and onnxruntime.
VIDEO_PYTHON_BIN=

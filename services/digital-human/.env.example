# 本地联调：复制为 .env.local；只配合绑定 127.0.0.1 的开发服务使用。
# 本地未配置 SSO 时沿用上游开发模式，无登录、无账号隔离。
# 生产需要独立账号（AUTH_MODE=standalone + PostgreSQL）或配置自己的 SSO。
AUTH_MODE=sso
AUTH_DATABASE_URL=
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_DESKTOP_URL=http://127.0.0.1:3001
MAIN_APP_URL=
MAIN_APP_SSO_EXCHANGE_URL=
MAIN_APP_SSO_CLIENT_SECRET=
APP_SESSION_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:3001
PUBLIC_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3001
NEXT_TELEMETRY_DISABLED=1

# 真正生成前，模型必须能够通过公网访问输入媒体；localhost 只用于本地联调。
# 配音：密钥留空表示尚未接通。默认音色 URL 留空时，请在音色库上传参考声音。
INDEXTTS_302_API_KEY=
INDEXTTS_BASE_URL=https://api.302.ai
INDEXTTS_SPEAKER_AUDIO_URL=
INDEXTTS_EMOTION_AUDIO_PATH=
INDEXTTS_EMOTION_AUDIO_URL=
INDEXTTS_DOWNLOAD_HOSTS=302.ai

# 对口型引擎按页面/API 的 engine 选择：a = OpenLux/PixVerse，b = fal/VEED，c = HeyGen。
# 原页面默认 b。LIPSYNC_PROVIDER 不会覆盖请求中选定的 engine。
LIPSYNC_PROVIDER=veed
FAL_KEY=
FAL_VEED_MODEL=veed/lipsync
FAL_DOWNLOAD_HOSTS=fal.ai,fal.run,fal.media
OPENLUX_API_KEY=
OPENLUX_API_BASE_URL=https://api.openlux.ai
OPENLUX_LIPSYNC_MODEL=pixverse-lipsync
PIXVERSE_SOURCE_HOSTS=pixverseai.cn,openlux.ai
PIXVERSE_DOWNLOAD_HOSTS=openlux.ai,pixverse.ai,pixverseai.cn
PIXVERSE_INGEST_URL=
PIXVERSE_INGEST_TOKEN=
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://api.heygen.com
HEYGEN_MCP_TRANSPORT=direct
HEYGEN_MCP_SERVER_URL=https://mcp.heygen.com/mcp/v1
HEYGEN_DOWNLOAD_HOSTS=heygen.com,heygen.ai
MCP_SSE_AUTH_TOKEN=

# 可选对象存储，必须使用本项目自己的完整配置。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CUSTOM_DOMAIN=

# 可选动效功能。配音/对口型首轮联调无需填写。
MOTION_API_KEY=
MOTION_API_BASE_URL=https://api.302.ai
MOTION_SUMMARY_MODEL=gpt-4o-mini
MOTION_AGENT_BASE_URL=
MOTION_AGENT_MODEL=
MOTION_AGENT_API_KEY=
REMOTION_BROWSER_EXECUTABLE=
